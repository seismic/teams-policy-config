{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "electron/**/*.ts",
    "src/vite-env.d.ts"
  ]
}